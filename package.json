{
  "name": "mexc-harsi-scanner",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node --check src/config.js && node --check src/candle-history-cache.js && node --check src/mexc-client.js && node --check src/candle-window.js && node --check src/harsi.js && node --check src/neon-store.js && node --check src/scanner.js && node --check src/live-scanner.js && node --check src/local-sqlite-store.js && node --check src/local-scanner.js && node --check src/server.js && node --check public/android-app.js && node --check scripts/prepare-android-background.js && node --check vite.config.js && vite build --config vite.config.js",
    "start": "node src/server.js",
    "scan": "node --env-file-if-exists=.env.local --env-file-if-exists=.env src/scanner.js",
    "test": "node --test",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "desktop:build": "npm run build && electron-builder --win nsis",
    "desktop:build:x86": "npm run build && electron-builder --win nsis --ia32",
    "desktop:build:x64": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "vite": "^7.2.2",
    "electron": "22.3.27",
    "electron-builder": "24.13.3",
    "better-sqlite3": "8.7.0",
    "undici": "5.28.5"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.harsi.scanner",
    "productName": "Harsi",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "www/**/*",
      "src/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32",
            "x64"
          ]
        }
      ],
      "artifactName": "Harsi-Setup-${arch}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
